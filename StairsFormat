#include <iostream>
using namespace std;

int main()
{
    int n;
    
    cout<<"===Stairs Format===\n";
    cout<<"Enter number: ";
    cin>>n;
    
    if(n<=0){
        cout<<"Invalid input. Please enter a natural number (greater than zero).";
        return 1;
    }
    
    for (int i=1; i<=n; i++){
        for (int a=1; a<=i; a++){
            cout<<"* ";
        }
    cout<<endl;
    }

    return 0;
}
