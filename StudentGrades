#include <iostream>
using namespace std;
 
int main()
{
    cout<<"===Student Grades===\n";
    
    int students; 
    double grade;
    double total=0;
    int passed = 0, failed=0;
    
    cout << "Enter number of students: ";
    cin >> students; 
    
    if (students<=0){
        cout << "Invalid number of students.\n";
        return 0;
    }
    
    for (int i=1;i<=students;i++) {
        cout << "Grade of student: " << i << ": ";
        cin >> grade;
        if (grade <0 || grade > 100) {
            cout << "Invalid grade. Try again\n";
            i--;
            continue;
        }
        total += grade; 
        if (grade>=75){
            cout << "PASSED\n";
            passed++;
        }else{
            cout << "FAILED\n";
            failed++;
        }
    }
    cout << "\nAverage: " << total/students;
    cout << "\nPassed: "<<passed;
    cout << "\nFailed: "<<failed; 

 
 
    return 0;
}
