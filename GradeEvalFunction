#include <iostream>
using namespace std;
 
void evaluateGrade(double);
 
int main()
{
    double grade;
    
    cout << "===Grade Evaluation===\n";
    
    cout << "Enter student grade 0-100: ";
    cin >> grade;
 
    cout << "===Results===\n";
 
    if (grade <0 || grade >100){
        cout << "Invalid grade\n";
        return 1;
    }
    
    evaluateGrade(grade);
    return 0;
}
 
void evaluateGrade(double grade){
    if (grade >= 75)
        cout << "Result: PASSED\n";
    else
        cout << "Result: FAILED\n";
}
