/******************************************************************************

Enter a grade 0-100

if grade >=75 - Passed (Average)

Sentinel Variable - program will stop

*******************************************************************************/
#include <iostream>
using namespace std;

int main() {
    
    int grade, count=0, passed=0;
    double total;
    
    cout<<"===Grade with Sentinel Value===\n";
    
    cout<<"Enter a grade (-1 to stop): ";
    cin>>grade;
    
    while (grade != -1) {
        if (grade>=0 && grade <=100) {
            total += grade;
            count++;
            
            if (grade >=75) {
                passed++;
            }
            
        } else {
            cout<<"Invalid grade.\n";
        }
        
        cout<<"Enter a grade (-1 to stop): ";
        cin>>grade;
        
    }    
    
    if (count > 0) {
        cout<<"Average: "<<total/count<<endl;
        cout<<"Passed: "<<passed<<endl;
        
    } else {
        cout<<"No valid grades entered.\n";
        
    }
    
    return 0;
}
