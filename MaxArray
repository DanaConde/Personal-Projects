#include <iostream>
using namespace std;

int main()
{
    int size;
    
    cout<<"==Size and Elements of Array, Max===\n";
    
    cout<<"\nEnter number of elements: ";
    cin>>size;
    
    int num[size];
    cout<<"Enter "<<size<<" elements: \n";
    
    for (int i=0; i<size; i++) {
        cout<<"Number "<<i+1<<": ";
        cin>>num[i];
    }
    int max=num[0];
    for (int i=1; i<size; i++) {
        if (num[i]>max){
            max=num[i];
        }
    }
    cout<<"The max element is: "<<max<<endl;
    return 0;
}
