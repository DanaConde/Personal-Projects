#include <iostream>
using namespace std;

int main() {
    int x;

    cout << "Enter a number: ";
    
    if (cin >> x) {
        
        if (x % 2 == 0) {
            cout << "The number is even.";
        }
        
        else {
            cout << "The number is odd.";
        }
    }
    
    else {
        cout << "Invalid input. Please enter a number.";
    }

    return 0;
}
